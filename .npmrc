# @copilotkit/runtime depends on @copilotkit/channels-intelligence, which
# publishes vitest as a PEER dependency. npm's resolver crashes outright on
# that graph ("Cannot read properties of null (reading 'edgesOut')"), so peer
# resolution has to be skipped for any install to complete — including CI and
# platform builds that run `npm install` unattended.
legacy-peer-deps=true
