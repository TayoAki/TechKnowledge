# The pair partner needs one model provider. OpenRouter is preferred when both
# are set. The board, clock and coverage meter work without either.

# OpenRouter (OpenAI-compatible; https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the model. OpenRouter ids look like "vendor/model".
# Check https://openrouter.ai/models for what your key can reach.
# DECOMP_MODEL=anthropic/claude-sonnet-4.5

# Alternative: Anthropic direct
# ANTHROPIC_API_KEY=sk-ant-...

# CopilotKit phones home by default.
COPILOTKIT_TELEMETRY_DISABLED=true
